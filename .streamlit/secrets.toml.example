# ── 서비스계정 키 (구글 클라우드에서 발급한 JSON을 여기에 붙여넣기) ──
# 실제 운영 시엔 .streamlit/secrets.toml 로 복사해 값 채우고, 절대 깃에 커밋하지 말 것.
# Streamlit Cloud 배포 시엔 앱 Settings > Secrets 에 그대로 붙여넣습니다.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "lf-da-dashboard@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# (선택) 폴더 ID 오버라이드 — 기본값은 drive_fetch.py 상수 사용
# [drive]
# sojae_root_id = "1q6_Gwow3UbjJ9kGEnkufywoUfD8dfkda"
# perf_root_id  = "1XRFf_ipD_usxYZ6v34Z_lHR3QOpncEGU"

# Gemini 비전 API 키 (AI Studio 무료 발급)
gemini_api_key = "AIza..."
